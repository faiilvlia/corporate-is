      "surfaceActive": { "$value": "{primitive.color.obsidian.800}", "$type": "color" },
      "textPrimary": { "$value": "{primitive.color.titanium.50}", "$type": "color" },
      "textSecondary": { "$value": "{primitive.color.titanium.400}", "$type": "color" },
      "textMuted": { "$value": "{primitive.color.titanium.600}", "$type": "color" },
