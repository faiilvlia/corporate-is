    "btn": {
      "primaryBg": { "$value": "{primitive.color.titanium.50}", "$type": "color" },
      "primaryText": { "$value": "{primitive.color.obsidian.950}", "$type": "color" },
      "accentBg": { "$value": "{semantic.color.accent}", "$type": "color" },
      "accentText": { "$value": "{primitive.color.titanium.50}", "$type": "color" },
      "radius": { "$value": "{primitive.radius.sm}", "$type": "dimension" }
    },
    "badge": {
      "radius": { "$value": "{primitive.radius.full}", "$type": "dimension" },
      "font": { "$value": "{primitive.fontFamily.mono}", "$type": "fontFamily" }
